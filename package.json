{
  "name": "neica-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "dev:review": "vite --mode review --host 127.0.0.1 --port 4174 --strictPort",
    "content:sync": "node scripts/content.mjs sync",
    "content:check": "node scripts/content.mjs check",
    "content:prepare": "node scripts/content.mjs prepare",
    "content:approve": "node scripts/content.mjs approve",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/qa.mjs",
    "test:production": "node scripts/qa-production.mjs",
    "format": "prettier --write src scripts tests vite.config.ts package.json tsconfig.json .github/workflows/pages.yml",
    "build": "npm run content:check && tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
